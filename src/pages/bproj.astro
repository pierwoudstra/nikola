---
import Layout from '../layouts/Layout.astro';
import image1 from '../assets/niko1.JPG';
import image2 from '../assets/niko2.JPG';
import image3 from '../assets/niko3.jpg';
import Image from 'astro/components/Image.astro';
---

<Layout>
<div class="neverending">
        <Image src={image1} alt="niko1" loading="lazy" />
        <Image src={image2} alt="niko2" loading="lazy" />
        <Image src={image3} alt="niko3" loading="lazy" />
    </div>
</Layout>
