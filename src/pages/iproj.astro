---
import Layout from '../layouts/Layout.astro';
import image1 from '../assets/convo1.jpeg';
import image2 from '../assets/convo2.jpeg';
import Image from 'astro/components/Image.astro';
---

<Layout>
<div class="neverending">
        <h5>‘Conversations inside my head’ was a website I built during the first lockdown. I use it as a digital space for sketching ideas. Some of the links on there are just thoughts I’ve had, other are projects that have been worked out. You can find the page<a href="https://erikarukavina.hotglue.me"> here.</a></h5>
        <Image src={image1} alt="convo1" />
        <Image src={image2} alt="convo2" />
    </div>
</Layout>
