---
import Layout from '../layouts/Layout.astro';
import image1 from '../assets/tea3.jpg';
import image2 from '../assets/tea2.jpg';
import image3 from '../assets/tea1.jpg';
import Image from 'astro/components/Image.astro';
---

<Layout>
<section class="projects">
        <div class="column-1"> 
            <div class="a-container">
                <Image src={image1} alt="a" />
            </div>
        </div>

        <div class="column-2">
            <div class="b-container">
               <Image src={image2} alt="b" />
            </div>
            <div class="g-container">
                <Image src={image3} alt="g" />
            </div>
        </div>


    </section>
</Layout>
