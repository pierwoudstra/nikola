import smallframe3 from '../assets/smallframed2025-26/smallhanging1.png';
import smallframe4 from '../assets/smallframed2025-26/smallhanging2.png';
import smallframe5 from '../assets/smallframed2025-26/untitled 4.png';

import Image from 'astro/components/Image.astro';
---

<Layout>

    <div class="neverending">
        <Image src={smallframe1} alt="small frame"/>
        <Image src={smallframe2} alt="small frame"/>
        <Image src={smallframe3} alt="small frame"/>
        <Image src={smallframe4} alt="small frame"/>
        <Image src={smallframe5} alt="small frame"/>
        <br>
        <br>
        <br>
